{
  "name": "quick-code",
  "version": "0.1.0",
  "description": "Minimalist TUI AI agent that operates strictly within the current directory",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Sergii Shalapuda",
  "bin": {
    "quick-code": "./dist/quick-code"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --outfile dist/quick-code",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
